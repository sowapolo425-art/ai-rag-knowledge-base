[Unit]
Description=Enterprise Knowledge Base A public demo
After=network.target ai-rag-llm.service
Wants=ai-rag-llm.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/ai-rag-knowledge-base
EnvironmentFile=/home/ubuntu/apps/ai-rag-knowledge-base/.env
ExecStart=/home/ubuntu/apps/ai-rag-knowledge-base/.venv/bin/uvicorn app.main:create_app --factory --host 0.0.0.0 --port 80
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
