# Leave these blank to use the built-in offline demo mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
MAX_UPLOAD_MB=15
MAX_DOCUMENTS=20
ASK_RATE_PER_MINUTE=6
# Enable local Chinese semantic search without an external Embeddings API.
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Set to 1 on a public server after uploading the sample documents.
# DEMO_READONLY=1

# For a gateway running on the same computer as Docker:
# OPENAI_BASE_URL=http://host.docker.internal:8789/v1
# OPENAI_CHAT_MODEL=deepseek-v4.1-flash
# Leave OPENAI_EMBEDDING_MODEL blank if the gateway has no Embeddings API.
