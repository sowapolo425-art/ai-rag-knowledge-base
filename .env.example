# Leave these blank to use the built-in offline demo mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
MAX_UPLOAD_MB=15

# For a gateway running on the same computer as Docker:
# OPENAI_BASE_URL=http://host.docker.internal:8789/v1
# OPENAI_CHAT_MODEL=deepseek-v4.1-flash
# Leave OPENAI_EMBEDDING_MODEL blank if the gateway has no Embeddings API.
